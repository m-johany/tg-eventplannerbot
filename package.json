{
  "name": "telegram-event-bot",
  "version": "0.1.0",
  "description": "Telegram Event Planner Bot on Cloudflare Workers",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 execute eventplanner-db --remote --file=./src/db/migrations/0000_initial.sql",
    "db:migrate:local": "wrangler d1 execute eventplanner-db --file=./src/db/migrations/0000_initial.sql",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "grammy": "^1.34.0",
    "luxon": "^3.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250808.0",
    "@types/luxon": "^3.4.2",
    "drizzle-kit": "^0.28.0",
    "drizzle-orm": "^0.36.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^3.90.0"
  }
}
